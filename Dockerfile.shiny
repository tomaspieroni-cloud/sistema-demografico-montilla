FROM rocker/shiny:latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libxml2-dev \
    libicu-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN R -e "install.packages(c('DBI','RPostgres','dplyr','ggplot2','stringr','pool','zip','readr','tidyr','plotly'), repos='https://cloud.r-project.org')"

USER root
