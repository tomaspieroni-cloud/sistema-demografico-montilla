# Copy this file to .env and change the values before running `docker compose up -d`.
# .env is excluded from version control.

# Main database (demographic indicators)
DB_NAME=montilla_db
DB_USER=montilla_user
DB_PASS=change_me
DB_EXTERNAL_PORT=5433

# Superset metadata database
SUPERSET_DB_NAME=superset_db
SUPERSET_DB_USER=superset_user
SUPERSET_DB_PASS=change_me

# Superset application
SUPERSET_SECRET_KEY=replace_with_a_long_random_string
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change_me

# Published ports
SHINY_PORT=3839
SUPERSET_PORT=8088

# Only needed to re-run the R pipeline outside Docker:
# folder that contains the downloaded raw data (Datos/, Datos INE/, ...)
MONTILLA_DATA_DIR=/path/to/raw-data
DB_HOST=localhost
DB_PORT=5433
